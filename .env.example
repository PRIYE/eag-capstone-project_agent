# Copy this file to .env and fill in real values. Never commit .env.
# Names only here - no real credentials or keys belong in this file.

# AgentSwitch instances
AS_URL=
AS_EMAIL=
AS_PASSWORD=

# Keystone (US) - used when running with --instance keystone
AS_KEYSTONE_URL=
AS_KEYSTONE_PASSWORD=

# Model provider (one of: openai, anthropic, google, openrouter)
MODEL_PROVIDER=
MODEL_NAME=

# Provider API keys (set only the one matching MODEL_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
